#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# Default to the whole repo so bin/lint, CI, and the pre-commit hook agree on
# scope. Why: docs/memory/log/2026-08-18-lint-scope.md
paths=("$@")
if [ ${#paths[@]} -eq 0 ]; then
  paths=(.)
fi

# Run all linters even if an earlier one fails, so the developer
# sees the full set of findings in one pass instead of round-tripping.
exit_code=0
uv run ruff check "${paths[@]}" || exit_code=$?
uv run ruff format --check "${paths[@]}" || exit_code=$?
uv run pyright "${paths[@]}" || exit_code=$?
# JSON checks (whole repo): every file parses; data artifacts are canonical.
# Uses `uv run` to share the canonical-format helper from src/.
uv run python bin/lint-json.py || exit_code=$?
exit $exit_code
