{
  "$schema": "https://dprint.dev/schemas/v0.json",
  // Effectively disables wrapping. dprint has no "off"; removing the key would
  // fall back to its defaults (markdown 80, JSON/TS 120), which still wrap.
  "lineWidth": 10000,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  // Import statements keep their order, since it is module evaluation order. Names within one import still sort.
  "typescript": {
    "module.sortImportDeclarations": "maintain"
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/pnpm-lock.yaml",
    "**/target",
    "**/dist",
    "**/build",
    "**/vendor",
    // Upstream files as fetched, and captured copies of them for tests.
    "data/source/**",
    "tests/fixtures/**",
    // Written by the pipeline in a canonical form that bin/lint-json.py enforces.
    "data/generated/**",
    "data/manual/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm@9c52244de2c25a33addc7ddacff4443234a2dc4b5d3f34131262d1e0df35007c",
    "https://plugins.dprint.dev/markdown-0.22.1.wasm@4906fbb038977732aae0e216e4b0b957e2722f8d79282660ccb36d27dd051f17",
    "https://plugins.dprint.dev/toml-0.7.0.wasm@0126c8112691542d30b52a639076ecc83e07bace877638cee7c6915fd36b8629",
    "https://plugins.dprint.dev/json-0.21.3.wasm@f34c8fbaeda1f42c479d4a5fa2c86f93d105c2d527ec61fffe912e4d9dc5cc77",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.2.wasm@35b00c8a70bdb5bbf29695cc11c076ab7608ed7aca0b065862ae0b05f70883ae",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm@1c1b31f972ef5aae052f97b6723aaf962e0175c5bbe4ba877e092512af354113",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm@40a2fdda7040317eb1b23520f3a00769a5571eedb049c4ca9175c1b9eeba01ae"
  ]
}
